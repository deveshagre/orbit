# ==========================================
# ORBIT Backend Environment Configuration
# ==========================================

# Google Gemini API Key (Required for inference)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
ORBIT_MODEL=gemini-2.5-flash

# Allowed CORS origins for the frontend
# In production, set to your frontend domain: e.g. https://orbit-app.vercel.app
# For local dev or open testing, use: *
ALLOWED_ORIGINS=*

# Server Port (Cloud Run injects PORT automatically; default: 5100 local / 8080 Cloud Run)
PORT=5100

# Optional API key protection (leave empty to disable, or set a secret token)
# If set, clients must pass `X-API-Key: <token>` or `Authorization: Bearer <token>`
ORBIT_API_KEY=

# Rate Limiting & Safety Limits
ORBIT_RATE_LIMIT_PER_MINUTE=60
ORBIT_MAX_REQUEST_SIZE_BYTES=1048576
ORBIT_MAX_MESSAGE_LENGTH=8000
ORBIT_MAX_CONVERSATIONS=500

# Agent Context & Generation Limits
ORBIT_MAX_TOOL_ROUNDS=5
ORBIT_MAX_HISTORY_MESSAGES=16
ORBIT_CONTEXT_MESSAGES=8
ORBIT_MAX_OUTPUT_TOKENS=1024
ORBIT_TEMPERATURE=0.2

# Local-Only Tools (Disabled by default in cloud deployments)
ORBIT_ENABLE_APP_LAUNCHER=false
ORBIT_ENABLE_LOCAL_FILESYSTEM=false

# Gunicorn Production Settings
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
